#!/data/data/com.termux/files/usr/bin/bash
set -eu
: "${PREFIX:=/data/data/com.termux/files/usr}"
if [ "${KWIN_ANDROID_GL_MODE:-}" != system ]; then
    echo "qt-system-gles-run requires explicit KWIN_ANDROID_GL_MODE=system" >&2
    exit 2
fi
source "$PREFIX/bin/kwin-android-rendering-env"
kwin_android_configure_qt_clients
exec "$@"
